---
import LandingLayout from '../layouts/LandingLayout.astro'
import LandingHero from '../components/LandingHero.astro'
import LandingAlgorithms from '../components/LandingAlgorithms.astro'
import LandingBenchmarks from '../components/LandingBenchmarks.astro'
import LandingAccess from '../components/LandingAccess.astro'
---

<LandingLayout>
  <LandingHero />
  <LandingAlgorithms />
  <LandingBenchmarks />
  <LandingAccess />

  <footer class="border-t border-border">
    <div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-4 px-6 py-8">
      <span class="font-mono text-sm text-text">teeline</span>
      <nav class="flex items-center gap-6 font-mono text-xs">
        <a href="/solve/" class="text-text-dim transition-colors hover:text-text">solver</a>
        <a href="/algorithms/" class="text-text-dim transition-colors hover:text-text">algorithms</a>
        <a href="/problems/" class="text-text-dim transition-colors hover:text-text">problems</a>
        <a href="/blog/" class="text-text-dim transition-colors hover:text-text">blog</a>
        <a href="https://github.com/timgluz/teeline" target="_blank" rel="noopener noreferrer" class="text-text-dim transition-colors hover:text-text">
          github ↗
        </a>
      </nav>
      <span class="font-mono text-xs text-text-dim">v0.2.1 · MIT</span>
    </div>
  </footer>
</LandingLayout>
