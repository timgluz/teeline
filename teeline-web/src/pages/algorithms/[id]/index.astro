---
// Replaces scripts/build-docs.mjs + scripts/templates/algorithm-page.eta.
// One dynamic route generates every algorithm doc page from the `docs`
// content collection (src/content.config.ts, sourced directly from
// docs/algorithms/*.md — no copying, no separate generation step).
import { getCollection, render } from 'astro:content'
import DocsLayout from '../../../layouts/DocsLayout.astro'
import AlgorithmBenchmarks from '../../../components/AlgorithmBenchmarks'

export async function getStaticPaths() {
  const entries = await getCollection('docs')
  return entries.map((entry) => ({ params: { id: entry.data.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const canonicalUrl = `https://tspsolver.com/algorithms/${entry.data.id}/`

// The published shard carries the numbers but not an instance's display name or distance
// type, so those come from the problem collection at build time. The benchmark section
// itself is a client island: it fetches at runtime so republishing a shard does not need a
// redeploy, and so the build cannot fail when R2 is unreachable (decision 9).
const problems = await getCollection('problems')
const instances = Object.fromEntries(
  problems.map((problem) => [
    problem.data.id,
    {
      name: problem.data.name,
      edgeWeightType: problem.data.edgeWeightType,
      cities: problem.data.cities,
    },
  ]),
)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.name,
  description: entry.data.description,
  url: canonicalUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
}
---
<DocsLayout
  title={`${entry.data.name} — Teeline`}
  description={entry.data.description}
  path={`/algorithms/${entry.data.id}/`}
  currentId={entry.data.id}
  name={entry.data.name}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  {entry.data.typeBadge && <p class="mb-2 font-sans text-xs uppercase tracking-wider text-accent">{entry.data.typeBadge}</p>}
  {entry.data.hasExplainer && (
    <a class="explainer-cta float-right mb-6 ml-6 rounded-md bg-accent px-5 py-2.5 font-medium text-white no-underline hover:opacity-90" href={`/algorithms/${entry.data.id}/explainer/`}>▶ Open interactive explainer →</a>
  )}
  <Content />
  <AlgorithmBenchmarks
    id={entry.data.id}
    dev={import.meta.env.DEV}
    instances={instances}
    client:visible
  />
</DocsLayout>
