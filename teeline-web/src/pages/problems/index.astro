---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

const problems = await getCollection('problems')
const groups = { small: [] as typeof problems, medium: [] as typeof problems, large: [] as typeof problems, xl: [] as typeof problems }
for (const p of problems) groups[p.data.sizeGroup].push(p)
const groupLabels = { small: 'Small (≤100)', medium: 'Medium (101–500)', large: 'Large (501–2000)', xl: 'XL (>2000)' }
const groupIcons = { small: '🟢', medium: '🟡', large: '🟠', xl: '🔴' }

const title = 'Problems — Teeline'
const description = 'Browse TSP problem instances from TSPLIB95. Each instance includes city count, edge weight type, known optimal tour cost, and a download link.'
---

<BaseLayout title={title} description={description} path="/problems/">
  <main class="mx-auto max-w-content px-6 py-8">
    <h1 class="text-2xl font-semibold tracking-tight lg:text-3xl">TSP Problem Instances</h1>
    <p class="mt-3 text-text-dim">{description}</p>

    {
      (Object.entries(groups) as [keyof typeof groups, typeof problems][]).map(([key, items]) => (
        items.length > 0 && (
          <section class="mt-6">
            <h2 class="text-xl font-semibold tracking-tight">{groupIcons[key]} {groupLabels[key]} ({items.length})</h2>
            <div class="mt-3 overflow-x-auto rounded-lg border border-border bg-surface">
              <table class="w-full border-collapse text-sm">
                <thead>
                  <tr class="border-b border-border">
                    <th class="px-4 py-2 text-left font-semibold text-text-dim">Name</th>
                    <th class="px-4 py-2 text-left font-semibold text-text-dim">Cities</th>
                    <th class="px-4 py-2 text-left font-semibold text-text-dim">Type</th>
                    <th class="px-4 py-2 text-left font-semibold text-text-dim">Optimal</th>
                  </tr>
                </thead>
                <tbody>
                  {items.map((p) => (
                    <tr class="border-b border-border last:border-b-0">
                      <td class="px-4 py-2"><a href={`/problems/${p.data.id}/`} class="text-accent no-underline hover:underline">{p.data.name}</a></td>
                      <td class="px-4 py-2">{p.data.cities.toLocaleString()}</td>
                      <td class="px-4 py-2"><code>{p.data.edgeWeightType}</code></td>
                      <td class="px-4 py-2">{p.data.optimalCost !== null ? p.data.optimalCost.toLocaleString() : '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      ))
    }
  </main>
</BaseLayout>
