---
import { getCollection, render } from 'astro:content'
import DocsLayout from '../../../layouts/DocsLayout.astro'
import ProblemResults from '../../../components/ProblemResults'

export async function getStaticPaths() {
  const problems = await getCollection('problems')
  return problems.map((entry) => ({
    params: { id: entry.data.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { data } = entry
const { Content } = await render(entry)

const pagePath = `/problems/${data.id}/`
const canonicalUrl = `https://tspsolver.com${pagePath}`

const sizeIcon = { small: '🟢', medium: '🟡', large: '🟠', xl: '🔴' }[data.sizeGroup] || ''
const solverLink = data.optimalCost !== null
  ? `/solve/?dataset=${data.id}&opt=${data.optimalCost}`
  : `/solve/?dataset=${data.id}`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: data.name,
  description: `${data.description} — ${data.cities} cities, ${data.edgeWeightType}. TSPLIB95 TSP instance.`,
  identifier: data.id,
  url: canonicalUrl,
  image: data.minimapUrl,
  creator: {
    '@type': 'Organization',
    name: data.creator,
    url: data.sourceUrl,
  },
  license: data.license,
  size: data.cities,
  variableMeasured: data.edgeWeightType,
  ...(data.optimalCost !== null ? { measurementTechnique: `Optimal tour length: ${data.optimalCost}` } : {}),
  includedInDataCatalog: {
    '@type': 'DataCatalog',
    name: data.source,
    url: data.sourceUrl,
  },
  distribution: {
    '@type': 'DataDownload',
    contentUrl: data.dataUrl,
    encodingFormat: 'text/plain',
  },
}
---

<DocsLayout
  title={`${data.name} — Teeline`}
  description={data.description}
  path={pagePath}
  currentId={data.id}
  name={data.name}
  currentType="problem"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="mb-2 font-sans text-xs uppercase tracking-wider text-accent">{sizeIcon} {data.sizeGroup} · {data.cities} cities</div>

  <p class="-mt-2 mb-6">
    <strong>{data.description}</strong>
  </p>

  {data.minimapUrl && (
    <figure class="mt-0 mb-6">
      <img
        src={data.minimapUrl}
        width="340"
        height="200"
        loading="lazy"
        decoding="async"
        alt={data.minimapDerived
          ? `City layout for ${data.name}, derived from its distance matrix`
          : `Map of ${data.name}`}
      />
      {data.minimapDerived && (
        <figcaption class="mt-2 text-xs text-text-dim">
          Layout derived from the distance matrix — this instance publishes no coordinates.
        </figcaption>
      )}
    </figure>
  )}

  <Content />

  <ProblemResults
    id={data.id}
    dev={import.meta.env.DEV}
    optimalCost={data.optimalCost}
    client:visible
  />

  <table class="mt-6">
    <thead>
      <tr><th scope="col">Property</th><th scope="col">Value</th></tr>
    </thead>
    <tbody>
      <tr><td>Name</td><td><code>{data.id}</code></td></tr>
      <tr><td>Cities</td><td>{data.cities.toLocaleString()}</td></tr>
      <tr><td>Type</td><td><code>{data.edgeWeightType}</code></td></tr>
      {data.optimalCost !== null && (
        <tr><td>Optimal tour</td><td><strong>{data.optimalCost.toLocaleString()}</strong></td></tr>
      )}
      <tr><td>Source</td><td><a href={data.sourceUrl} target="_blank" rel="noopener">{data.source}</a></td></tr>
      <tr><td>Creator</td><td>{data.creator}</td></tr>
      <tr><td>License</td><td><a href={data.license} target="_blank" rel="noopener">TSPLIB95 terms</a></td></tr>
    </tbody>
  </table>

  <div class="doc-actions mt-6 flex flex-wrap gap-3">
    <a href={data.dataUrl} download class="btn-solid btn--secondary inline-flex items-center gap-2 rounded-md border border-border px-5 py-2.5 font-medium text-text no-underline transition-colors hover:border-border-hover hover:bg-surface">
      ⬇ Download dataset
    </a>
    <a href={solverLink} class="btn-solid btn--primary inline-flex items-center gap-2 rounded-md bg-accent px-5 py-2.5 font-medium text-white no-underline transition-colors hover:bg-accent/90">
      ▶ Open in Solver
    </a>
  </div>

</DocsLayout>
