---
import {
  BERLIN52_BENCHMARKS,
  FAMILY_COLORS,
  FAMILY_LABELS,
  LABELED_IDS,
  type Family,
} from '../lib/benchmark-data'

// Chart geometry
const W = 720
const H = 420
const PAD = { left: 60, right: 24, top: 24, bottom: 48 }
const plotW = W - PAD.left - PAD.right
const plotH = H - PAD.top - PAD.bottom

// Axes: x = runtime (log10 scale, 1ms..20s), y = gap % (linear 0..150)
const X_MIN = 0 // log10(1ms)
const X_MAX = Math.log10(20000) // log10(20s)
const Y_MIN = 0
const Y_MAX = 150

function x(runtimeMs: number): number {
  return PAD.left + (Math.log10(Math.max(runtimeMs, 1)) - X_MIN) / (X_MAX - X_MIN) * plotW
}
function y(gapPct: number): number {
  return PAD.top + (1 - (gapPct - Y_MIN) / (Y_MAX - Y_MIN)) * plotH
}

// x-axis ticks
const xTicks = [
  { label: '1ms', val: 1 },
  { label: '10ms', val: 10 },
  { label: '100ms', val: 100 },
  { label: '1s', val: 1000 },
  { label: '10s', val: 10000 },
]
// y-axis ticks
const yTicks = [0, 5, 10, 15, 20, 25].concat(145)

const families: Family[] = ['exact', 'constructive', 'local', 'meta']
---

<section id="benchmarks" class="mx-auto max-w-content px-6 py-16 lg:py-24">
  <div class="mb-10 max-w-2xl">
    <p class="mb-3 font-mono text-xs uppercase tracking-wider text-accent">benchmarks</p>
    <h2 class="text-2xl font-semibold tracking-tight lg:text-4xl">Twenty algorithms, one chart.</h2>
    <p class="mt-3 text-text-dim">
      Runtime vs optimality gap on berlin52. Every dot is a solve. Lower-left is better: fast and optimal.
    </p>
  </div>

  <div class="rounded-lg border border-border bg-surface p-4 lg:p-6">
    <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label="Benchmark scatter chart of runtime vs optimality gap">
      <!-- gridlines (x) -->
      {xTicks.map((t) => (
        <g key={t.label}>
          <line x1={x(t.val)} y1={PAD.top} x2={x(t.val)} y2={PAD.top + plotH} stroke="#232327" stroke-width="1" />
          <text x={x(t.val)} y={H - 22} text-anchor="middle" font-size="10" fill="#8A8A92" font-family="JetBrains Mono, monospace">{t.label}</text>
        </g>
      ))}
      <!-- gridlines (y) -->
      {yTicks.map((v) => (
        <g key={v}>
          <line x1={PAD.left} y1={y(v)} x2={PAD.left + plotW} y2={y(v)} stroke="#232327" stroke-width="1" />
          <text x={PAD.left - 10} y={y(v) + 3} text-anchor="end" font-size="10" fill="#8A8A92" font-family="JetBrains Mono, monospace">{v}%</text>
        </g>
      ))}
      <!-- axis labels -->
      <text x={PAD.left + plotW / 2} y={H - 6} text-anchor="middle" font-size="11" fill="#8A8A92">runtime →</text>
      <text x={14} y={PAD.top + plotH / 2} text-anchor="middle" font-size="11" fill="#8A8A92" transform={`rotate(-90 14 ${PAD.top + plotH / 2})`}>gap vs optimal →</text>

      <!-- "better" hint -->
      <text x={PAD.left + 6} y={PAD.top + 14} font-size="11" fill="#22D3A5" font-family="JetBrains Mono, monospace">better</text>

      <!-- data points -->
      {BERLIN52_BENCHMARKS.map((p) => (
        <g key={p.id}>
          <circle cx={x(p.runtimeMs)} cy={y(p.gapPct)} r="4" fill={FAMILY_COLORS[p.family]} opacity="0.9" />
          {LABELED_IDS.has(p.id) && (
            <text x={x(p.runtimeMs) + 7} y={y(p.gapPct) + 3} font-size="10" fill="#F5F5F6" font-family="JetBrains Mono, monospace">{p.id}</text>
          )}
        </g>
      ))}
    </svg>

    <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-border pt-4">
      {families.map((f) => (
        <span key={f} class="inline-flex items-center gap-2 font-mono text-xs">
          <svg class="inline-block h-2 w-2" viewBox="0 0 8 8" aria-hidden="true">
            <circle cx="4" cy="4" r="4" fill={FAMILY_COLORS[f]} />
          </svg>
          <span class="text-text">{FAMILY_LABELS[f]}</span>
        </span>
      ))}
      <span class="ml-auto font-mono text-xs text-text-dim">berlin52 · 52 cities · release build</span>
    </div>
  </div>
</section>
