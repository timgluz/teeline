---
import { SOLVER_GROUPS, SOLVER_META } from '../nav-data'
import LandingAlgoDiagram from './LandingAlgoDiagram.astro'

interface FamilySpec {
  label: string
  index: string
  blurb: string
  group: string
  diagram: 'exact' | 'constructive' | 'local' | 'meta'
}

const FAMILIES: FamilySpec[] = [
  {
    label: 'Exact',
    index: '01',
    blurb:
      'Guaranteed optimum, exponential cost. Use on small instances (≤ 18 cities) or when you need a ground-truth bound.',
    group: 'Exact',
    diagram: 'exact',
  },
  {
    label: 'Constructive',
    index: '02',
    blurb:
      'Build a tour from nothing, one decision at a time. Fast, deterministic, usually 10–25% off optimal — perfect seeds for local search.',
    group: 'Constructive',
    diagram: 'constructive',
  },
  {
    label: 'Local search',
    index: '03',
    blurb:
      'Start with a tour, improve it by small structural moves. The workhorse — 2-opt alone gets within 5% of optimal in milliseconds.',
    group: 'Local search',
    diagram: 'local',
  },
  {
    label: 'Metaheuristic',
    index: '04',
    blurb:
      'Trade wall-clock for quality. Escape local optima with memory, randomness, or population-based search. Use when local search plateaus.',
    group: 'Metaheuristic',
    diagram: 'meta',
  },
]
---

<section id="algorithms" class="mx-auto max-w-content px-6 py-16 lg:py-24">
  <div class="mb-10 max-w-2xl">
    <p class="mb-3 font-mono text-xs uppercase tracking-wider text-accent">algorithms</p>
    <h2 class="text-2xl font-semibold tracking-tight lg:text-4xl">Twenty algorithms, grouped by intent.</h2>
    <p class="mt-3 text-text-dim">
      Not a flat sidebar. Each family has a different reason to exist — pick the right tool for the instance.
    </p>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    {FAMILIES.map((family) => {
      const group = SOLVER_GROUPS.find((g) => g.label === family.group)
      const solvers = group ? group.ids : []
      return (
        <article class="rounded-lg border border-border bg-surface p-6 transition-colors hover:border-border-hover">
          <div class="mb-4 flex items-start justify-between gap-4">
            <div>
              <p class="font-mono text-xs text-text-dim">family · {family.index}</p>
              <h3 class="mt-1 text-xl font-semibold tracking-tight">{family.label}</h3>
            </div>
            <LandingAlgoDiagram kind={family.diagram} />
          </div>
          <p class="mb-5 text-sm text-text-dim">{family.blurb}</p>
          <ul class="flex flex-wrap gap-2">
            {solvers.map((id) => {
              const meta = SOLVER_META[id]
              if (!meta) return null
              return (
                <li>
                  <a
                    href={`/algorithms/${id}/`}
                    class="inline-flex items-center rounded-full border border-border px-3 py-1 font-mono text-xs text-text transition-colors hover:border-accent hover:text-accent"
                  >
                    {meta.name}
                  </a>
                </li>
              )
            })}
          </ul>
        </article>
      )
    })}
  </div>
</section>
