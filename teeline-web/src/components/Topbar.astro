---
// Server-rendered replacement for nav-html.mjs's renderTopbarHtml() + topbar.ts's
// initTopbar(). Astro renders this markup server-side by default, so the
// vite.config.ts ssr-nav-html plugin's build-time string injection (and the
// duplicate client-side re-render in docs-init.ts) is unnecessary here — this
// component IS the server render. Only the dropdown close-on-outside-click
// behavior is genuine client interactivity, kept as a small inline script.
import { SOLVER_GROUPS, SOLVER_META, PAGED_SOLVERS } from '../nav-data'
---
<nav class="topbar" aria-label="Site navigation">
  <ul>
    <li><a class="topbar-logo" href="/">teeline</a></li>
  </ul>
  <button
    type="button"
    id="topbar-toggle"
    class="topbar-hamburger"
    aria-label="Toggle menu"
    aria-expanded="false"
    aria-controls="topbar-menu"
  >
    <span aria-hidden="true">☰</span>
  </button>
  <ul id="topbar-menu" class="topbar-menu">
    <li>
      <details class="dropdown">
        <summary>Algorithms</summary>
        <ul>
          {SOLVER_GROUPS.map((g) => (
            <>
              <li class="algo-group-label"><strong>{g.label}</strong></li>
              {g.ids.map((id) => {
                const meta = SOLVER_META[id]
                if (!meta) return null
                return (
                  <li>
                    {PAGED_SOLVERS.has(id) ? (
                      <a href={`/algorithms/${id}/`}>{meta.name}</a>
                    ) : (
                      <span>{meta.name}</span>
                    )}
                  </li>
                )
              })}
            </>
          ))}
        </ul>
      </details>
    </li>
    <li>
      <a href="/blog/">Blog</a>
    </li>
    <li>
      <a href="https://github.com/timgluz/teeline" target="_blank" rel="noopener noreferrer"
        >GitHub ↗</a
      >
    </li>
  </ul>
</nav>

<script>
  const nav = document.querySelector('nav.topbar')
  const toggle = document.getElementById('topbar-toggle')
  const menu = document.getElementById('topbar-menu')

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('topbar-menu--open') ?? false
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false')
  })

  document.addEventListener('click', (event) => {
    const details = nav?.querySelector<HTMLDetailsElement>('details.dropdown')
    if (details && nav && !nav.contains(event.target as Node)) {
      details.removeAttribute('open')
    }
    if (nav && !nav.contains(event.target as Node)) {
      menu?.classList.remove('topbar-menu--open')
      toggle?.setAttribute('aria-expanded', 'false')
    }
  })
</script>
