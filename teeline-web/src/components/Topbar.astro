---
// Server-rendered site navigation. Used by LandingLayout (landing page) and
// BaseLayout (all docs pages) with a single dark-theme styling via Tailwind.
// (nav-data no longer imported here — the algorithms index page owns the list)
---

<nav class="sticky top-0 z-50 border-b border-border bg-canvas/90 backdrop-blur" aria-label="Site navigation">
  <div class="mx-auto flex max-w-content items-center gap-6 px-6 py-3">
    <ul class="flex list-none items-center gap-6 p-0">
      <li>
        <a class="topbar-logo text-lg font-semibold tracking-tight text-text no-underline" href="/">teeline</a>
      </li>
    </ul>
    <button
      type="button"
      id="topbar-toggle"
      class="topbar-hamburger ml-auto border-0 bg-transparent text-xl text-text md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="topbar-menu"
    >
      <span aria-hidden="true">☰</span>
    </button>
    <ul id="topbar-menu" class="topbar-menu absolute left-0 right-0 top-full hidden flex-col items-start gap-3 border-b border-border bg-canvas px-6 py-4 md:static md:ml-auto md:flex md:list-none md:flex-row md:items-center md:gap-6 md:border-b-0 md:bg-transparent md:p-0">
      <li>
        <a href="/algorithms/" class="font-mono text-sm text-text-dim no-underline transition-colors hover:text-text">Algorithms</a>
      </li>
      <li>
        <a href="/solve/" class="font-mono text-sm text-text-dim no-underline transition-colors hover:text-text">Solver</a>
      </li>
      <li>
        <a href="/problems/" class="font-mono text-sm text-text-dim no-underline transition-colors hover:text-text">Problems</a>
      </li>
      <li>
        <a href="/blog/" class="font-mono text-sm text-text-dim no-underline transition-colors hover:text-text">Blog</a>
      </li>
      <li>
        <a href="https://github.com/timgluz/teeline" target="_blank" rel="noopener noreferrer" class="font-mono text-sm text-text-dim no-underline transition-colors hover:text-text">GitHub ↗</a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const nav = document.querySelector('nav')
  const toggle = document.getElementById('topbar-toggle')
  const menu = document.getElementById('topbar-menu')

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden')
    toggle.setAttribute('aria-expanded', menu?.classList.contains('hidden') ? 'false' : 'true')
  })

  document.addEventListener('click', (event) => {
    if (nav && !nav.contains(event.target as Node)) {
      menu?.classList.add('hidden')
      toggle?.setAttribute('aria-expanded', 'false')
    }
  })</script>
