---
// Server-rendered replacement for nav-html.mjs's renderSidebarHtml() +
// algorithms-sidebar.ts's initSidebar(). The old client-side version had to
// infer currentId from window.location.pathname because static HTML shells
// didn't know their own route; Astro's getStaticPaths() params give us the
// id directly at build time, so this whole client-side inference is gone.
import { SOLVER_GROUPS, SOLVER_META, PAGED_SOLVERS } from '../nav-data'

interface Props {
  currentId: string | null
}

const { currentId } = Astro.props
---
<ul>
  {
    SOLVER_GROUPS.map((g) => (
      <li class="sidebar-group">
        <span class="sidebar-group-label">{g.label}</span>
        <ul>
          {g.ids.map((id) => {
            const meta = SOLVER_META[id]
            if (!meta) return null
            const isCurrent = id === currentId
            return (
              <li class={`sidebar-item${isCurrent ? ' sidebar-item--current' : ''}`}>
                {isCurrent ? (
                  <span aria-current="page">{meta.name}</span>
                ) : PAGED_SOLVERS.has(id) ? (
                  <a href={`/algorithms/${id}/`}>{meta.name}</a>
                ) : (
                  <span>{meta.name}</span>
                )}
              </li>
            )
          })}
        </ul>
      </li>
    ))
  }
</ul>
