---
// Server-rendered docs sidebar. Tailwind-styled dark theme to match the
// site-wide design tokens.
import { SOLVER_GROUPS, SOLVER_META, PAGED_SOLVERS, PROBLEM_GROUPS, PROBLEM_META } from '../nav-data'

interface Props {
  currentId: string | null
  currentType?: 'algorithm' | 'problem'
}

const { currentId, currentType = 'algorithm' } = Astro.props
---
<ul class="m-0 list-none p-0">
  {currentType === 'algorithm' && (
    <Fragment>
      <li class="px-4 pb-1 pt-2 font-sans text-xs font-semibold tracking-wide text-text">Algorithms</li>
      {
        SOLVER_GROUPS.map((g) => (
          <li class="mb-1">
            <span class="block px-4 pb-1 pt-2 font-sans text-[0.7rem] font-bold uppercase tracking-wider text-text-dim">{g.label}</span>
            <ul class="m-0 list-none p-0">
              {g.ids.map((id) => {
                const meta = SOLVER_META[id]
                if (!meta) return null
                const isCurrent = id === currentId
                return (
                  <li class={isCurrent ? 'border-l-2 border-accent bg-accent-dim' : ''}>
                    {isCurrent ? (
                      <span aria-current="page" class="block px-4 py-1 text-sm font-semibold text-accent">{meta.name}</span>
                    ) : PAGED_SOLVERS.has(id) ? (
                      <a href={`/algorithms/${id}/`} class="block px-4 py-1 text-sm text-text no-underline hover:bg-surface-2 hover:text-accent">{meta.name}</a>
                    ) : (
                      <span class="block px-4 py-1 text-sm text-text">{meta.name}</span>
                    )}
                  </li>
                )
              })}
            </ul>
          </li>
        ))
      }
    </Fragment>
  )}
  {currentType === 'problem' && (
    <Fragment>
      <li class="px-4 pb-1 pt-2 font-sans text-xs font-semibold tracking-wide text-text">Problems</li>
      {
        PROBLEM_GROUPS.map((g) => (
          <li class="mb-1">
            <span class="block px-4 pb-1 pt-2 font-sans text-[0.7rem] font-bold uppercase tracking-wider text-text-dim">{g.label}</span>
            <ul class="m-0 list-none p-0">
              {g.ids.map((id) => {
                const meta = PROBLEM_META[id]
                if (!meta) return null
                const isCurrent = id === currentId
                return (
                  <li class={isCurrent ? 'border-l-2 border-accent bg-accent-dim' : ''}>
                    {isCurrent ? (
                      <span aria-current="page" class="block px-4 py-1 text-sm font-semibold text-accent">{meta.name}</span>
                    ) : (
                      <a href={`/problems/${id}/`} class="block px-4 py-1 text-sm text-text no-underline hover:bg-surface-2 hover:text-accent">{meta.name}</a>
                    )}
                  </li>
                )
              })}
            </ul>
          </li>
        ))
      }
    </Fragment>
  )}
</ul>
