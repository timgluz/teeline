---
import BaseLayout from './BaseLayout.astro'
import Sidebar from '../components/Sidebar.astro'

interface Props {
  title: string
  description: string
  path: string
  currentId: string | null
  name: string
  currentType?: 'algorithm' | 'problem'
}

const { title, description, path, currentId, name, currentType = 'algorithm' } = Astro.props
---
<BaseLayout title={title} description={description} path={path} ogType="article">
  <Fragment slot="head"><slot name="head" /></Fragment>
  <div class="docs-layout">
    <aside class="docs-sidebar">
      <nav aria-label="Documentation">
        <Sidebar currentId={currentId} currentType={currentType} />
      </nav>
    </aside>
    <main class="docs-main">
      <nav aria-label="breadcrumb">
        <ul>
          <li><a href="/">teeline</a></li>
          {currentType === 'problem' ? (
            <li><a href="/problems/">Problems</a></li>
          ) : (
            <li>Algorithms</li>
          )}
          <li>{name}</li>
        </ul>
      </nav>
      <slot />
    </main>
  </div>
</BaseLayout>
