---
import '@fontsource/inter/400.css'
import '@fontsource/inter/500.css'
import '@fontsource/inter/600.css'
import '@fontsource/jetbrains-mono/400.css'
import '../styles/global.css'
import Topbar from '../components/Topbar.astro'

interface Props {
  title: string
  description: string
  // Optional so status pages (404) can omit a canonical URL for a path that
  // does not exist.
  path?: string
  ogType?: 'website' | 'article'
  ogDescription?: string
  // Per-page card: the site default is a single brand image, which says nothing about the page it
  // is attached to. When a page passes its own, the dimensions and the Twitter card follow it.
  ogImage?: string
  ogImageAlt?: string
  ogImageWidth?: number
  ogImageHeight?: number
}

const {
  title,
  description,
  path,
  ogType = 'website',
  ogDescription,
  ogImage = 'https://tspsolver.com/og-image.png',
  ogImageAlt = 'teeline — TSPSolver, find your path',
  ogImageWidth = 540,
  ogImageHeight = 630,
} = Astro.props
const isDefaultOgImage = ogImage === 'https://tspsolver.com/og-image.png'
const canonicalUrl = path ? `https://tspsolver.com${path}` : undefined
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content={isDefaultOgImage ? 'summary' : 'summary_large_image'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <Topbar />
    <slot />
  </body>
</html>
