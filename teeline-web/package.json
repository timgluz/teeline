{
  "name": "teeline-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsc --noEmit && astro build && node scripts/copy-wasm.mjs",
    "build:check": "astro check && tsc --noEmit && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "deploy": "npm run build && wrangler pages deploy dist/"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@bytecodealliance/preview2-shim": "^0.17.9",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sentry/browser": "^10.70.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "astro": "^7.2.2",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "teeline-wasm": "file:../teeline-wasm/js-bindings"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "5.20260815.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "13.0.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
