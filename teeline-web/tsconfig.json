{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /* "node" is needed by tests that read repo files at runtime — currently
       src/lib/solver-index.test.ts, which cross-checks the website's solver
       index against the canonical bench/solvers.json the shell scripts read.
       Without it, tsc rejects `node:fs`/`node:url` imports in that test and
       `npm run build` fails. */
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Strictness */
    "strict": true,
    "useDefineForClassFields": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/content.config.ts",
    "src/content/**",
    "src/pages/**",
    "src/layouts/**",
    "src/components/**"
  ]
}
