{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Strictness */
    "strict": true,
    "useDefineForClassFields": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* Astro owns pages, layouts and content: they import the `astro:*` virtual modules and `.astro`
     files, which only its language server resolves. The components are plain Preact and are checked
     here — excluding them hid an undefined identifier in an island for as long as the exclusion
     existed. Astro components under src/components are not TypeScript, so this program ignores them
     and `astro check` covers those. */
  "exclude": [
    "src/content.config.ts",
    "src/content/**",
    "src/pages/**",
    "src/layouts/**"
  ]
}
